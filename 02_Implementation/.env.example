# Copy to .env and fill in. .env is git-ignored – never commit real secrets.
DB_PASSWORD=change-me-db-password
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
CONFERENCE_NAME=Informatics Conference 2026
MAIL_FROM=registration@example.org
# Comma-separated list of organizer recipients
MAIL_ORGANIZERS=organizers@example.org
ADMIN_USERNAME=organizer
# At least 12 characters
ADMIN_PASSWORD=change-me-strong-password
# At least 32 characters, random (e.g. openssl rand -base64 48)
FORM_TOKEN_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
FRONTEND_PORT=8080
