# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
APP_ORGANIZER_USERNAME=organizer
# At least 16 characters.
APP_ORGANIZER_PASSWORD=change-me-to-a-long-random-value
APP_ORGANIZER_EMAILS=organizers@example.org
# Organizer endpoints refuse plain HTTP. Keep true in production (HTTPS at the reverse proxy);
# set false only for the local plain-HTTP compose stack.
APP_ORGANIZER_REQUIRE_HTTPS=true
APP_MAIL_FROM=registration@example.org
APP_CONFERENCE_NAME=Conference
# true only for local development and automated tests; never in production.
RECAPTCHA_TEST_MODE=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
