<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!--
    EI_EXPOSE_REP2 reports every constructor that keeps a reference to an object it was given.
    The use cases and adapters are wired by constructor injection of shared collaborators (ports),
    which is exactly that and is intended. Data holders copy their collections instead, and
    EI_EXPOSE_REP (returning internal state) stays enabled.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
