<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- D-14 (docs/decisions-log.md): the executed SQL is the storage contract read from the jar
       (contracts/registration-storage.sql), never user input. -->
  <Match>
    <Class name="si.konferenca.registration.infrastructure.migration.V1__Create_registration_storage"/>
    <Method name="migrate"/>
    <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
  </Match>
  <!-- D-16 (docs/decisions-log.md): constructor-injected shared collaborators (JsonMapper,
       TransactionTemplate, Clock, mail sender) are dependencies, not internal representation. -->
  <Match>
    <Or>
      <Class name="si.konferenca.registration.application.RegistrationJson"/>
      <Class name="si.konferenca.registration.application.RegistrationService"/>
      <Class name="si.konferenca.registration.infrastructure.RecaptchaVerifier"/>
      <Class name="si.konferenca.registration.infrastructure.MailRegistrationNotifier"/>
      <Class name="si.konferenca.registration.application.OrganizerAccessService"/>
      <Class name="si.konferenca.registration.api.RequestLimitsFilter"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
