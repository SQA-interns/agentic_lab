<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!-- HttpSecurity.build() declares "throws Exception"; the bean method cannot narrow it. -->
  <Match>
    <Class name="si.konferenca.registration.config.SecurityConfiguration"/>
    <Method name="securityFilterChain"/>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>
  <!-- Constructor injection of shared collaborators (transaction template, entity manager,
       mail sender, clock): keeping the injected reference is the intent. -->
  <Match>
    <Or>
      <Class name="si.konferenca.registration.application.RegistrationService"/>
      <Class name="si.konferenca.registration.application.ExportService"/>
      <Class name="si.konferenca.registration.infrastructure.JpaRegistrationRepository"/>
      <Class name="si.konferenca.registration.infrastructure.SmtpRegistrationNotifier"/>
    </Or>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- A request wrapper must return the same input stream on every call. -->
  <Match>
    <Class name="si.konferenca.registration.api.RequestSizeFilter$LimitedRequest"/>
    <Method name="getInputStream"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
