<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- D-21, D-23: constructor-injected Spring singletons are shared by design, not internal state. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <And>
        <Class name="si.konferenca.registration.service.NotificationService"/>
        <Field name="copies"/>
      </And>
      <And>
        <Class name="si.konferenca.registration.service.ExportService"/>
        <Or>
          <Field name="store"/>
          <Field name="writer"/>
        </Or>
      </And>
    </Or>
  </Match>
</FindBugsFilter>
