{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conference-config.schema.json",
  "title": "Conference configuration",
  "description": "Options and consents offered by the registration forms (US-003, AR-04, D-11, D-12, D-14). Read by the backend at startup from the configured file; changing it needs a restart, never a code change. The participant fields (BR-01) are not configurable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["consents", "options"],
  "properties": {
    "categoryLimits": {
      "description": "Optional maximum number of selected options per category (D-14). A category without an entry has no maximum.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "WORKSHOP": { "$ref": "#/$defs/limit" },
        "EVENT": { "$ref": "#/$defs/limit" },
        "MEAL": { "$ref": "#/$defs/limit" },
        "OTHER": { "$ref": "#/$defs/limit" }
      }
    },
    "consents": {
      "description": "Mandatory consents (BR-05, D-12). Each must be given; none is preselected.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "category", "active"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier", "description": "Stable identifier; never reused for another option." },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "category": { "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
          "active": { "type": "boolean" },
          "availableTo": {
            "description": "Registration types that may select the option (D-11). Absent means both.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["EXTERNAL", "STUDENT"] }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
