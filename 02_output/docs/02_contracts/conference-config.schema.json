{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conference-config.schema.json",
  "title": "Conference options configuration (AR-04, US-003)",
  "description": "JSON file read at startup from CONFERENCE_CONFIG_PATH. The backend refuses to start if the file does not validate or option ids are not unique. Changing it never changes the fixed participant fields (BR-01).",
  "type": "object",
  "additionalProperties": false,
  "required": ["options", "consents"],
  "properties": {
    "maxSelectionsPerCategory": {
      "description": "D-17: maximum selected options per category; a missing category means 1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "WORKSHOP": { "type": "integer", "minimum": 0 },
        "EVENT": { "type": "integer", "minimum": 0 },
        "MEAL": { "type": "integer", "minimum": 0 },
        "OTHER": { "type": "integer", "minimum": 0 }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "active", "availableTo"],
        "properties": {
          "id": { "description": "Stable identifier, unique in the file", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "category": { "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
          "active": { "type": "boolean" },
          "availableTo": {
            "description": "D-14: registration types that may select the option",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["EXTERNAL", "STUDENT"] }
          }
        }
      }
    },
    "consents": {
      "description": "D-15: consents shown on both forms, never preselected",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "mandatory": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
