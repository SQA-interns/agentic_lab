{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lab-conference:catalog-config:1",
  "title": "External startup catalog (CONFERENCE_CONFIG_PATH)",
  "description": "Loaded once at backend startup (AR-07, BR-10). Option IDs must be unique across all groups; the backend refuses to start on any violation (D-19).",
  "type": "object",
  "additionalProperties": false,
  "required": ["conferenceTitle", "groups"],
  "properties": {
    "conferenceTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workshops", "events", "meals", "other"],
      "properties": {
        "workshops": { "$ref": "#/$defs/options" },
        "events": { "$ref": "#/$defs/options" },
        "meals": { "$ref": "#/$defs/options" },
        "other": { "$ref": "#/$defs/options" }
      }
    }
  },
  "$defs": {
    "options": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "active"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
