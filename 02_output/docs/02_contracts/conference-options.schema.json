{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conference-options.schema.json",
  "title": "Conference options configuration",
  "description": "JSON file read at backend start from CONFERENCE_OPTIONS_FILE (AR-04). Changing it needs a restart, never a code change, and cannot change the participant fields (BR-01). The backend refuses to start when the file does not match this schema or when two options share an id. Default file (local and test only): conference-options.example.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["consent", "options"],
  "properties": {
    "consent": {
      "type": "object",
      "description": "The single mandatory consent (D-07)",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "active"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier; never reuse it for another option (AC-003-04)",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "category": { "enum": ["workshop", "event", "meal", "other"] },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
