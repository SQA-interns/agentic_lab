{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konferenca:conference-options:1",
  "title": "Conference options configuration (AR-04, US-003)",
  "description": "File read by the backend at startup from CONFERENCE_OPTIONS_FILE. Changing it changes options, limits and consents without code changes; participant fields (BR-01) are not configurable. The backend refuses to start if the file violates this schema or an option or consent id repeats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "options", "consents"],
  "properties": {
    "categories": {
      "description": "Maximum number of options a participant may select per category (D-14); a missing category defaults to 1.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "WORKSHOP": { "$ref": "#/$defs/limit" },
        "EVENT": { "$ref": "#/$defs/limit" },
        "MEAL": { "$ref": "#/$defs/limit" },
        "OTHER": { "$ref": "#/$defs/limit" }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "active"],
        "properties": {
          "id": { "$ref": "#/$defs/id", "description": "Stable identifier; never reused for another option." },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "category": { "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
          "active": { "type": "boolean" },
          "registrationTypes": {
            "description": "Who may select the option (D-11); default both.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["EXTERNAL", "STUDENT"] },
            "default": ["EXTERNAL", "STUDENT"]
          }
        }
      }
    },
    "consents": {
      "description": "Consents shown on both forms (D-12); at least one is mandatory.",
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": { "mandatory": { "const": true } },
        "required": ["mandatory"]
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "mandatory"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "mandatory": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "limit": { "type": "integer", "minimum": 0, "maximum": 50 }
  }
}
