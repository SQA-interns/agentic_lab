{
  "testRunner": "vitest",
  "mutate": ["src/**/*.{ts,tsx}", "!src/**/*.test.{ts,tsx}", "!src/main.tsx", "!src/test-setup.ts"],
  "reporters": ["clear-text", "json", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" }
}
