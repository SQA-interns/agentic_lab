# Owner: Architect. Read in: phase 0. Agent: read-only.
# Copy into the repository's ignored .env; never commit or print real values.
# Names below are the configuration contract for the generated implementation.

# PostgreSQL application password; local and production; operator must provide
DB_PASSWORD=
# Organizer login name; local and production; operator must provide
ORGANIZER_USERNAME=
# Organizer password encoded as a supported salted slow hash; local and production; operator must provide
ORGANIZER_PASSWORD_HASH=
# Public captcha site key (not confidential); production; not needed in explicit local/test mode
RECAPTCHA_SITE_KEY=
# Captcha verification secret; production; not needed in explicit local/test mode
RECAPTCHA_SECRET_KEY=
# SMTP login; production if relay requires authentication; not needed for isolated local catcher
SMTP_USERNAME=
# SMTP password; production if relay requires authentication; not needed for isolated local catcher
SMTP_PASSWORD=
# Dependency-Check database API credential, if required by configured data source; verification; operator supplies if needed
NVD_API_KEY=

# No JWT/session-signing key: participant accounts and token-based organizer auth are out of scope.
# TLS/ACME credentials, if needed, belong to external proxy operations, not app containers.
# Captcha and SMTP production keys may stay empty locally only with explicit safe local profiles.
# No credentials have been generated, obtained, tested or marked provided in this package.
