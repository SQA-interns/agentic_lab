# Copy to .env and fill in real values. Never commit a filled-in .env.

NODE_ENV=production
PORT=3000

# Persistent storage: holds the SQLite database and the JSON backup files.
DATA_DIR=/data

# Conference programme (workshops, events, meals, other activities).
OPTIONS_CONFIG_FILE=/app/config/conference-options.json

# Anti-automation. Must be at least 32 characters and secret.
FORM_TOKEN_SECRET=change-me-to-a-long-random-secret-value
FORM_TOKEN_TTL_SECONDS=1800
FORM_MIN_FILL_SECONDS=3

# Exact origins allowed to call the API. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:8080
MAX_BODY_BYTES=32768
# Set to true only when the application really runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Email. MAIL_TRANSPORT must be "smtp" in production.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=conference@example.org
ORGANIZER_EMAILS=organizer@example.org

# Credentials for the Excel export endpoint. Password must be at least 12 characters.
EXPORT_USERNAME=organizer
EXPORT_PASSWORD=change-me-please

LOG_LEVEL=info

# Rate limits, per client address. The write limit is the anti-abuse control and is
# deliberately strict. The read limits must stay generous: one page load costs one
# configuration request, and many legitimate participants share a single public address
# behind NAT, so a tight read limit denies the form to all of them at once.
RATE_LIMIT_REGISTRATION_MAX=5
RATE_LIMIT_REGISTRATION_WINDOW_MINUTES=10
RATE_LIMIT_CONFIG_MAX=300
RATE_LIMIT_CONFIG_WINDOW_MINUTES=5
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
